# syntax=docker/dockerfile:1

# The controller container: runs the Ansible playbook and then pytest.
#
# AIR-GAPPED USE
#
# Every external dependency is overridable. The compose files pass these from
# the environment variables named in the right-hand column:
#
#   TESTER_BASE_IMAGE    TESTER_BASE_IMAGE      base image
#   APT_MIRROR           APT_MIRROR             host[/path] of a Debian mirror
#   APT_SECURITY_MIRROR  APT_SECURITY_MIRROR    security suite (defaults to APT_MIRROR)
#   CUSTOM_CA_CERT_BASE64 CUSTOM_CA_CERT_BASE64 base64-encoded root CA PEM
#   PIP_INDEX            PIP_INDEX_URL          internal PyPI .../simple
#   PIP_TRUSTED          PIP_TRUSTED_HOST       host to trust behind a private CA
#   GALAXY_SERVER        ANSIBLE_GALAXY_SERVER  internal Ansible Galaxy
#
# The build arguments deliberately avoid the ANSIBLE_* and PIP_* names.
# Docker exposes every ARG as an environment variable inside RUN, and both
# tools read their own configuration from the environment -- an ARG named
# ANSIBLE_GALAXY_SERVER left empty makes ansible-galaxy try to contact a server
# at "", which fails with "unknown url type: 'api'". Writing config files
# instead applies the setting only when one was actually given.
#
# Collection versions are pinned here and must exist on the Galaxy mirror.
ARG TESTER_BASE_IMAGE=debian:11-slim
FROM ${TESTER_BASE_IMAGE}
ARG CUSTOM_CA_CERT_BASE64=""
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt
RUN if [ -n "${CUSTOM_CA_CERT_BASE64}" ]; then \
      printf "%s" "${CUSTOM_CA_CERT_BASE64}" | base64 -d > /usr/local/share/ca-certificates/custom-root-ca.crt; \
      update-ca-certificates; \
    fi


ARG ansible_core_version
ARG APT_MIRROR=""
ARG APT_SECURITY_MIRROR=""
ARG PIP_INDEX=""
ARG PIP_TRUSTED=""
ARG GALAXY_SERVER=""

ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Redirect apt at the internal mirror before the first update.
RUN if [ -n "${APT_MIRROR}" ]; then \
      sec="${APT_SECURITY_MIRROR:-${APT_MIRROR}}"; \
      printf '%s\n' \
        "deb http://${APT_MIRROR} bullseye main" \
        "deb http://${sec} bullseye-security main" \
        "deb http://${APT_MIRROR} bullseye-updates main" \
        > /etc/apt/sources.list; \
    fi

# pip.conf rather than PIP_INDEX_URL, so an unset value leaves pip's own
# default in place instead of overriding it with an empty string.
RUN if [ -n "${PIP_INDEX}" ]; then \
      mkdir -p /etc; \
      { echo '[global]'; \
        echo "index-url = ${PIP_INDEX}"; \
        [ -n "${PIP_TRUSTED}" ] && echo "trusted-host = ${PIP_TRUSTED}"; \
        true; \
      } > /etc/pip.conf; \
    fi

# Likewise for ansible-galaxy: written only when a mirror was given.
RUN if [ -n "${GALAXY_SERVER}" ]; then \
      mkdir -p /etc/ansible; \
      printf '%s\n' \
        '[galaxy]' \
        'server_list = internal' \
        '' \
        '[galaxy_server.internal]' \
        "url = ${GALAXY_SERVER}" \
        > /etc/ansible/ansible.cfg; \
    fi

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         python3 \
         python3-pip \
         openssh-client \
         build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade pip \
    && pip3 install \
         "ansible-core==${ansible_core_version}" \
         paramiko \
         pytest-testinfra \
         pyyaml

RUN ansible-galaxy collection install \
      community.postgresql:1.6.0 \
      ansible.posix:1.3.0 \
      community.general:2.5.8 \
      community.crypto:1.9.12
