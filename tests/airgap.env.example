# Air-gapped / mirrored environment settings for the test harness.
#
#   cp tests/airgap.env.example tests/airgap.env
#   # edit to match your Artifactory hosts
#   set -a; . tests/airgap.env; set +a
#   python3 tests/scripts/check-resources.py --case prod_topology
#   ./tests/run-case.sh prod_topology rhel9
#
# Everything below redirects one specific thing the harness would otherwise
# fetch from the public internet. check-resources.py reports any of these left
# unset as a WARN, because on a connected host the public default still works
# and the failure would only appear once you are actually isolated.

# ---------------------------------------------------------------------------
# Container images
# ---------------------------------------------------------------------------
# The database nodes and the controller container. Both must exist in your
# registry, or be pulled locally beforehand.
#
# A pull-through cache configured in daemon.json / registries.conf works too,
# in which case leave these at their defaults.
RHEL_BASE_IMAGE=your-artifactory/docker-remote/ubi9/ubi-init:9.7
TESTER_BASE_IMAGE=your-artifactory/docker-remote/debian:11-slim

# ---------------------------------------------------------------------------
# OS packages inside the images
# ---------------------------------------------------------------------------
# RPMs for the database nodes. When set, every repository the base image ships
# is disabled and this one is used instead, so the mirror must carry the base
# OS content as well as anything the roles install.
YUM_BASEURL=https://your-artifactory/artifactory/yum-remote
# Set to 0 if the mirror serves unsigned metadata.
YUM_GPGCHECK=1
# Optional: PEM file for a private root CA to trust inside every
# image build. Example: /absolute/path/to/root-ca.pem
#CUSTOM_CA_CERT_FILE=/absolute/path/to/root-ca.pem

# Debian packages for the controller container.
APT_MIRROR=your-artifactory/artifactory/debian-remote
# Optional: the security suite, when it lives at a different path.
#APT_SECURITY_MIRROR=your-artifactory/artifactory/debian-security-remote

# ---------------------------------------------------------------------------
# Python and Ansible content
# ---------------------------------------------------------------------------
PIP_INDEX_URL=https://your-artifactory/artifactory/api/pypi/pypi-remote/simple
# Needed when the mirror uses a private CA that the image does not trust.
#PIP_TRUSTED_HOST=your-artifactory

# The pinned collections (community.postgresql, ansible.posix, community.general,
# community.crypto) must be available here.
ANSIBLE_GALAXY_SERVER=https://your-artifactory/artifactory/api/galaxy/ansible-remote

# ---------------------------------------------------------------------------
# The run itself
# ---------------------------------------------------------------------------
CONTAINER_ENGINE=podman
EDB_PG_TYPE=PG
EDB_PG_VERSION=17
EDB_ENABLE_REPO=false
ANSIBLE_CORE_VERSION=2.15

# Set when your mirror presents a certificate this host does not trust, to let
# check-resources.py reach it anyway. It only affects the checker, never the
# deployment.
#CHECK_INSECURE=1

# ---------------------------------------------------------------------------
# What this file does NOT cover
# ---------------------------------------------------------------------------
# The PGDG and EPEL repositories that the *collection* installs during the
# deploy are Ansible variables, not environment variables, because the roles
# read them. Override them in the test case's vars.json (or your production
# group_vars) -- see tests/cases/prod_topology/vars.airgap.json.example:
#
#   pg_rpm_repo_9_x86_64, pg_gpg_key_9_x86_64, epel_repo_9, epel_gpg_key_9
#
# check-resources.py reads those four out of roles/setup_repo/defaults/main.yml
# and checks whatever they currently point at, so it stays in step with the
# role rather than duplicating the list.
